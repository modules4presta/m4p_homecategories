{
    "name": "modules4presta/m4p_homecategories",
    "description": "Shows the catalogue departments with a thumbnail, subcategories and product count on the home page.",
    "type": "prestashop-module",
    "license": "MIT",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.40"
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Nice Code sp. z o.o. (Modules4Presta)",
            "email": "contact@modules4presta.io",
            "homepage": "https://modules4presta.io"
        }
    ]
}
